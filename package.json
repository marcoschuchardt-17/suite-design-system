{
  "name": "@suite/design-system",
  "version": "0.1.0",
  "description": "Suite-Designsystem - Focus Flow x Nordic Clarity (MAR-89)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "npm run sync:css && npm run build:css && tsc -p tsconfig.json",
    "build:css": "esbuild src/styles/index.css --bundle --loader:.woff2=dataurl --loader:.woff=dataurl --outfile=src/styles/bundled.css",
    "sync:css": "node scripts/sync-css.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-morph": "^28.0.0",
    "typescript": "^7.0.2"
  },
  "private": true
}
